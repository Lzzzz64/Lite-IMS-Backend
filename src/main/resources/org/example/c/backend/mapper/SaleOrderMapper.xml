<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.c.backend.mapper.SaleOrderMapper">

    <resultMap id="BaseResultMap" type="org.example.c.backend.entity.SaleOrder">
            <id property="id" column="id" />
            <id property="userId" column="user_id" />
            <result property="orderNo" column="order_no" />
            <result property="customerId" column="customer_id" />
            <result property="totalAmount" column="total_amount" />
            <result property="status" column="status" />
            <result property="remark" column="remark" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <select id="selectOrderVOPage" resultType="org.example.c.backend.vo.OrderVO">
        select s.id, s.order_no, c.name as customerName, s.total_amount, s.status, s.create_time
        from sale_order s
        left join customer c on s.customer_id = c.id AND c.is_deleted = 0
        <where>
            s.is_deleted = 0
            <if test="orderNo != null and orderNo != ''">
                and s.order_no = #{orderNo}
            </if>
        </where>
        order by s.create_time desc
    </select>

</mapper>
