            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        id,username,password,nickname,avatar,email,
        create_time,update_time,is_deleted
    </sql>
</mapper>
